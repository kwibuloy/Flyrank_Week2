# Copy this file to .env and change the password:  cp .env.example .env
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks
# Host port for Postgres (5432 is often taken by another local Postgres).
POSTGRES_PORT=5433

# Used when you run the app directly on your machine (uvicorn).
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls.
# Inside docker compose the app gets its own URL pointing at the "db" service.
DATABASE_URL=postgresql://tasks:change-me@127.0.0.1:5433/tasks
